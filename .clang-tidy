---
# Noise suppression: start from everything, turn off whole modules/groups that are pure
# style churn for this codebase, and re-enable only specific valuable checks.
#
# Later glob entries win: '-modernize-*' turns off nearly all of the 'modernize' module
# (C arrays -> std::array, pass-by-value rewrites, emplace{} vs push_back{},
# std::ranges algorithms, designated initializers, macro->enum, trailing return types,
# [[nodiscard]] everywhere, auto-everything, ...); the six entries directly after it
# whitelist the few genuinely useful ones back in.
Checks: "*,
        performance-*,
        clang-analyzer-*,
        -hicpp-*,
        -abseil-*,
        -altera-*,
        -android-*,
        -fuchsia-*,
        -google-*,
        -llvm*,
        -boost*,
        -modernize-*,
        modernize-use-override,
        modernize-use-equals-default,
        modernize-use-equals-delete,
        modernize-use-nullptr,
        modernize-use-using,
        modernize-loop-convert,
        -zircon-*,
        -readability-else-after-return,
        -readability-static-accessed-through-instance,
        -readability-avoid-const-params-in-decls,
        -readability-identifier-length,
        -cppcoreguidelines-non-private-member-variables-in-classes,
        -cppcoreguidelines-avoid-magic-numbers,
        -cppcoreguidelines-owning-memory,
        -readability-named-parameter,
        -readability-magic-numbers,
        -readability-braces-around-statements,
        -readability-function-cognitive-complexity,
        -readability-convert-member-functions-to-static,
        -readability-math-missing-parentheses,
        -bugprone-easily-swappable-parameters,
        -cppcoreguidelines-avoid-c-arrays,
        -cppcoreguidelines-init-variables,
        -cppcoreguidelines-avoid-do-while,
        -cert-err09-cpp,
        -cert-err61-cpp,
        -misc-throw-by-value-catch-by-reference,
        -misc-non-private-member-variables-in-classes,
"
HeaderFilterRegex: ''
FormatStyle:     none
